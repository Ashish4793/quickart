                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <input required name="price" type="number" min="1" max="1000000"
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="$100">
                                </div>
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">Category
                                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <select name="category" id="category" required
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex">
                                        <option selected disabled value="" selected>Select a option</option>
                                        <option value="Mobiles">Mobiles</option>
                                        <option value="Electronics">Electronics</option>
                                        <option value="Fashion">Fashion</option>
                                        <option value="Furniture">Furniture</option>
                                        <option value="Groceries">Groceries</option>
                                    </select>
                                </div>
                            </div>
                            <div class="w-full justify-start items-start gap-7 flex sm:flex-row flex-col">
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">Brand
                                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <input name="brand" type="text" required
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="Sony">
                                </div>
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">Model
                                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <input name="model" type="text" required
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="Playstation 5">
                                </div>
                            </div>
                            <div class="w-full justify-start items-start gap-7 flex sm:flex-row flex-col">
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">Color
                                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <input required name="color" type="text"
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="White">
                                </div>
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">Is
                                        Front Page Article?
                                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <select name="fpa" id="fpa" required
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex">
                                        <option disabled value="" selected>Select a option</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-full flex-col justify-start items-start gap-6 inline-flex">
                        <h4 class="text-gray-900 text-xl font-semibold leading-8">Inventory Informatiom</h4>
                        <div class="w-full flex-col justify-start items-start gap-8 flex">
                            
                            <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                <label for=""
                                    class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">Detailed
                                    Description
                                    <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                        fill="none">
                                        <path
                                            d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                            fill="#EF4444" />
                                    </svg>
                                </label>
                                <textarea name="detailedDescription" required
                                    class="block w-full h-44 px-4 py-2 text-sm font-normal shadow-xs text-gray-900 bg-transparent border border-gray-300 rounded-lg placeholder-gray-400 focus:outline-none leading-relaxed resize-none"
                                    placeholder="Enter a description..."></textarea>
                                <label class="label">
                                    <span class="label-text-alt text-red-500">Important Note: Use ' = ' sign for
                                        bulletin
                                        points.</span>
                                </label>
                            </div>
                            <div class="w-full justify-start items-start gap-7 flex sm:flex-row flex-col">
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">Stock
                                        Quantity
                                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <input name="qty" required type="number" min="0" max="1000000"
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="500">
                                </div>
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">SKU ID
                                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7"
                                            fill="none">
                                            <path
                                                d="M3.11222 6.04545L3.20668 3.94744L1.43679 5.08594L0.894886 4.14134L2.77415 3.18182L0.894886 2.2223L1.43679 1.2777L3.20668 2.41619L3.11222 0.318182H4.19105L4.09659 2.41619L5.86648 1.2777L6.40838 2.2223L4.52912 3.18182L6.40838 4.14134L5.86648 5.08594L4.09659 3.94744L4.19105 6.04545H3.11222Z"
                                                fill="#EF4444" />
                                        </svg>
                                    </label>
                                    <input disabled type="text"
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="Will be auto-generated">
                                </div>
                            </div>
                            <label class="label cursor-pointer">
                                <span class="label-text">Add additional fields for information.</span>
                                <input id="utfCheckbox" onchange="showUTFs()" type="checkbox" class="checkbox ml-2" />
                            </label>
                            <div id="utf" class="hidden w-full justify-start items-start gap-7 flex sm:flex-row flex-col">
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">UTF 1
                                    </label>
                                    <input name="utf1" type="text"
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="Ex: RAM:8GB,SIZE:M">
                                </div>
                                <div class="w-full flex-col justify-start items-start gap-1.5 flex">
                                    <label for=""
                                        class="flex gap-1 items-center text-gray-600 text-base font-medium leading-relaxed">UTF 2
                                    </label>
                                    <input name="utf2" type="text"
                                        class="w-full focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed px-5 py-3 rounded-lg shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-200 justify-start items-center gap-2 inline-flex"
                                        placeholder="Ex: RAM:8GB,SIZE:M">
                                        
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <button
                    class="mx-auto sm:w-fit w-full px-7 py-3 bg-indigo-600 hover:bg-indigo-700 transition-all duration-700 ease-in-out rounded-xl shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] justify-center items-center flex">
                    <span class="px-2 text-center text-white text-lg font-semibold leading-8">Add Product</span>
                </button>
            </form>
            </div>
        </section>


        
        <script>
            function showUTFs() {
                const utfContainer = document.getElementById("utf");
                const checkbox = document.getElementById("utfCheckbox");

                if (checkbox.checked) {
                    utfContainer.classList.remove("hidden");
                } else {
                    utfContainer.classList.add("hidden");
                }
            }

        </script>

        <%- include('partials/footer'); -%>